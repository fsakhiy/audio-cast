<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Playback capture needs INTERNET only; deliberately NO RECORD_AUDIO:
         AudioPlaybackCapture goes through MediaProjection consent instead. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Held only while streaming, released on stop (milestone 6). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Lets the vivo guide request a battery-optimization exemption. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- REQUIRED since Android 15 for AudioPlaybackCapture itself (verified
         on Android 16 / iQOO: without it every read returns NO_INIT -38).
         We never capture from the microphone; it is the playback-capture
         permission gate, alongside the per-session MediaProjection consent. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_media_play"
        android:label="PhoneCast"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".StreamService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>

</manifest>
